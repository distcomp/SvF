SELECT: I AS Q, WPD AS VPD, E, Dat FROM "Phot-7shoX5.xlsx"

RUN:	
	MaxIter = 60
	RunMode = 'L&L'

PENALTY:
	SvF.resF = None
	a0=0.09433228
	a1=0.3181083

SET: 	Q = [ , ]
		VPD = [ , ]

VAR: 	E(Q,VPD) 

CV:	NumOfSets=7;  GroupByParam='Dat'

OBJ: 	E.MSD() + E.Complexity(Penal[0],Penal[1])

