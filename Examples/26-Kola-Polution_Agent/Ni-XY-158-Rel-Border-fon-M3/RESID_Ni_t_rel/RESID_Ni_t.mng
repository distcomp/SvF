SELECT * from RESID_Ni_t.dat
SET: t = [,,]
VAR: Residual_Ni(t)
CV:  NumOfSets = 7; 	#GroupByParam = "Dat"
RUN: MaxIter = 31;    #  RunMode="S&S" 
OBJ: Residual_Ni.MSDrel(2.0) + Residual_Ni.Complexity(Penal[0])
Residual_Ni.V.name = 'ΔNi'
PLOT: Residual_Ni, dms=1,xlab=t(Year),xlab_x=.9,xlab_y=.08 
EoF
### !!! plt.axhline (0, color='black', lw=0.5) 
