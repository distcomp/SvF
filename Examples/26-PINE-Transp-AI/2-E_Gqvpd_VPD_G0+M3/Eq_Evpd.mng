SELECT: ROWNUM as t, Q, T, VPD, E, Dat from ../Pine_Petr-08.xlsx 

SET: 	sQ = [ , ]; Data = 'Q'
#	sT = [ , ]; Data = 'T'
	sVPD = [ , ]; Data = 'VPD'
	t = [,,1]
	
PARAM:	Q  (t)
#	T (t)
	VPD (t)

VAR: 	E (t)
	Gqvpd (sQ, sVPD);	    Gqvpd(sQ.middle,sVPD.middle) = 1
	G0 > 0
	
EQ:	E(t) = G0 * Gqvpd(Q,VPD)  * 0.010017 * VPD

CV: 	NumOfSets=7; 	GroupByParam ='Dat'
RUN:	MaxIter = 31; #	RunMode = "L&S"

OBJ: 	E.MSD() + Gqvpd.Complexity(Penal[0],Penal[1])

PLOT: *

