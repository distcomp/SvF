COMPILE: TaskName = '2Body3D'

SELECT: t, x1, y1, z1, x2, y2, z2 FROM "../4bdn-1_0.9_0.2_0.06-abc.xlsx" as DB

SET: t = [ , , 0.01]  # временная ось с шагом 0.01


PLOT: 	DB.t, DB.x1, lw=0, c=r, marker='o', ms=2, label='x1-data', xlab='t',xlab_x=1.01,ylab='x1,y1,z1' + \
	DB.t, DB.y1, lw=0, c=g, marker='o', ms=2, label='x1-data' + \
	DB.t, DB.z1, lw=0, c=b, marker='o', ms=2, label='z1-data'
PLOT: 	DB.t, DB.x2, lw=0, c=r, marker='o', ms=2, label='x2-data', xlab='t',xlab_x=1.01,ylab='x2,y2,z2' + \
	DB.t, DB.y2, lw=0, c=g, marker='o', ms=2, label='x2-data' + \
	DB.t, DB.z2, lw=0, c=b, marker='o', ms=2, label='z2-data'

POLY: 	P1 ([DB.dat('x1')[0]], [DB.dat('y1')[0]])
	P2 ([DB.dat('x2')[0]], [DB.dat('y2')[0]])
	P1yz ([DB.dat('y1')[0]], [DB.dat('z1')[0]])
	P2yz ([DB.dat('y2')[0]], [DB.dat('z2')[0]])

PLOT: 	DB.x1, DB.y1, lw=0, c=red, marker='o', ms=2, label='Data1', xlab='x',xlab_x=1.01,ylab='y' + P1, ms=5, label='' + \
      	DB.x2, DB.y2, lw=0, c=green, marker='o', ms=2, label='Data2' + P2, ms=5, label=''      	
PLOT: 	DB.y1, DB.z1, lw=0, c=red, marker='o', ms=2, label='Data1', xlab='y',xlab_x=1.01,ylab='z' + P1yz, ms=5, label='' + \
      	DB.y2, DB.z2, lw=0, c=green, marker='o', ms=2, label='Data2 ' + P2yz, ms=5, label=''      	
EoF


PLOT: DB.x1, DB.z1, lw=0, c=red, marker='o', ms=2, label='Data1', xlab='x',xlab_x=1.01,ylab='y' + \
      DB.x2, DB.z2, lw=0, c=green, marker='o', ms=2, label='Data2' 
PLOT: DB.z1, DB.y1, lw=0, c=red, marker='o', ms=2, label='Data1', xlab='x',xlab_x=1.01,ylab='y' + \
      DB.z2, DB.y2, lw=0, c=green, marker='o', ms=2, label='Data2' 

EoF


