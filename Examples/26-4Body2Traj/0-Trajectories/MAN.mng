
COMPILE: TaskName = '4Body3D_Trajectories'

SELECT: t, x1, y1, z1, x2, y2, z2 FROM "../4bdn-1_0.9_0.2_0.06-abc.xlsx" as DB

SET: t = [ , , 0.1]  # временная ось с шагом 0.1

# Искомые траектории планет (без модели динамики)
VAR: x1(t)
VAR: y1(t)
VAR: z1(t)
VAR: x2(t)
VAR: y2(t)
VAR: z2(t)

CV: NumOfSets=7
RUN: MaxIter=-1

# Критерий: близость к данным + сглаживание траекторий
OBJ: x1.MSD() + y1.MSD() + z1.MSD() + \
     x2.MSD() + y2.MSD() + z2.MSD() + \
     x1.Complexity(Penal[0]) + y1.Complexity(Penal[1]) + z1.Complexity(Penal[2]) + \
     x2.Complexity(Penal[3]) + y2.Complexity(Penal[4]) + z2.Complexity(Penal[5])


POLY: 	P1 ([x1.grd[0]], [y1.grd[0]])
	P2 ([x2.grd[0]], [y2.grd[0]])

PLOT: DB.x1, DB.y1, lw=0, c=red, marker='o', ms=2, label='Data1', xlab='x',xlab_x=1.01,ylab='y' + P1, ms=5, label='' +\
      DB.x2, DB.y2, lw=0, c=green, marker='o', ms=2, label='Data2' + P2, ms=5, label=''+ \
      x1.grd,y1.grd,c=red,lw=2,label='Planet1',ms=0 + \
      x2.grd, y2.grd, c=green,  lw=2, label='Planet2'  

PLOT: 	x1,c=r + y1,c=g + z1,c=b, ylab='x1,y1,z1', ylab_x=.02
	x2,c=r + y2,c=g + z2,c=b, ylab='x2,y2,z2', ylab_x=.02
EoF

