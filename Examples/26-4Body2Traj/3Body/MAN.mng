COMPILE: TaskName = '3Body3D_2obs'

SELECT: t, x1, y1, z1, x2, y2, z2, x3, y3, z3 FROM "../4bdn-1_0.9_0.2_0.06-abc.xlsx" as DB

SET: t = [ , , 0.01]

VAR: x1(t)
     y1(t)
     z1(t)
     x2(t)
     y2(t)
     z2(t)
     x3(t)      #  инициализация из DB  !
     y3(t)
     z3(t)

G = 1

VAR: m1 > 0
     m2 > 0
     m3 > 0

EQ: x1'' = G * m2 * (x2 - x1) / ((x2 - x1)^2 + (y2 - y1)^2 + (z2 - z1)^2)^(3/2) + \
           G * m3 * (x3 - x1) / ((x3 - x1)^2 + (y3 - y1)^2 + (z3 - z1)^2)^(3/2)

EQ: y1'' = G * m2 * (y2 - y1) / ((x2 - x1)^2 + (y2 - y1)^2 + (z2 - z1)^2)^(3/2) + \
           G * m3 * (y3 - y1) / ((x3 - x1)^2 + (y3 - y1)^2 + (z3 - z1)^2)^(3/2)

EQ: z1'' = G * m2 * (z2 - z1) / ((x2 - x1)^2 + (y2 - y1)^2 + (z2 - z1)^2)^(3/2) + \
           G * m3 * (z3 - z1) / ((x3 - x1)^2 + (y3 - y1)^2 + (z3 - z1)^2)^(3/2)

EQ: x2'' = G * m1 * (x1 - x2) / ((x1 - x2)^2 + (y1 - y2)^2 + (z1 - z2)^2)^(3/2) + \
           G * m3 * (x3 - x2) / ((x3 - x2)^2 + (y3 - y2)^2 + (z3 - z2)^2)^(3/2)

EQ: y2'' = G * m1 * (y1 - y2) / ((x1 - x2)^2 + (y1 - y2)^2 + (z1 - z2)^2)^(3/2) + \
           G * m3 * (y3 - y2) / ((x3 - x2)^2 + (y3 - y2)^2 + (z3 - z2)^2)^(3/2)

EQ: z2'' = G * m1 * (z1 - z2) / ((x1 - x2)^2 + (y1 - y2)^2 + (z1 - z2)^2)^(3/2) + \
           G * m3 * (z3 - z2) / ((x3 - x2)^2 + (y3 - y2)^2 + (z3 - z2)^2)^(3/2)

EQ: x3'' = G * m1 * (x1 - x3) / ((x1 - x3)^2 + (y1 - y3)^2 + (z1 - z3)^2)^(3/2) + \
           G * m2 * (x2 - x3) / ((x2 - x3)^2 + (y2 - y3)^2 + (z2 - z3)^2)^(3/2)

EQ: y3'' = G * m1 * (y1 - y3) / ((x1 - x3)^2 + (y1 - y3)^2 + (z1 - z3)^2)^(3/2) + \
           G * m2 * (y2 - y3) / ((x2 - x3)^2 + (y2 - y3)^2 + (z2 - z3)^2)^(3/2)

EQ: z3'' = G * m1 * (z1 - z3) / ((x1 - x3)^2 + (y1 - y3)^2 + (z1 - z3)^2)^(3/2) + \
           G * m2 * (z2 - z3) / ((x2 - x3)^2 + (y2 - y3)^2 + (z2 - z3)^2)^(3/2)

CV: NumOfSets=7
RUN: MaxIter=1

OBJ: x1.MSD() + y1.MSD() + z1.MSD() + \
     x2.MSD() + y2.MSD() + z2.MSD()

POLY: 	P1 ([x1.grd[0]], [y1.grd[0]])
	P2 ([x2.grd[0]], [y2.grd[0]])
	P3 ([x3.grd[0]], [y3.grd[0]])

PLOT: DB.x1, DB.y1, lw=0, c=red, marker='o', ms=2, label='Data1', xlab='x',xlab_x=1.01,ylab='y' + \
      DB.x2, DB.y2, lw=0, c=green, marker='o', ms=2, label='Data2' +  \
      x1.grd,y1.grd,  c=red,    lw=2, label='Planet1',ms=0 + P1, ms=5, label='' + \
      x2.grd, y2.grd, c=green,  lw=2, label='Planet2',ms=0 + P2, ms=5, label=''+ \ 
      x3.grd, y3.grd, c=blue,   lw=2, label='Planet3',ms=0 + P3, ms=5, label='' 
#      DB.x3, DB.y3, lw=0, c=blue, marker='o', ms=0.5, label='Data3' + \

PLOT: 	x1,c=r          + y1,c=g + z1,c=b, ylab='x1,y1,z1', ylab_x=.02
	x2,c=r          + y2,c=g + z2,c=b, ylab='x2,y2,z2', ylab_x=.02
	x3,c=r, dms=0.0 + y3,c=g + z3,c=b, ylab='x3,y3,z3', ylab_x=.02
	
	
EoF
```
